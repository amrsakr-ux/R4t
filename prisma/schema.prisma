// Sana Academy — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum Gender {
  female
  male
}

enum LessonStatus {
  scheduled
  completed
  absent
  postponed
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum PaymentStatus {
  pending
  confirmed
  rejected
}

enum EvaluationGrade {
  excellent
  very_good
  good
  needs_review
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole
  fullName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student  Student?
  teacher  Teacher?
  admin    Admin?
  sessions Session[]

  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Program {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  students Student[]
  groups   Group[]
}

model Student {
  id          String   @id @default(uuid())
  userId      String   @unique
  programId   String?
  groupId     String?
  gender      Gender   @default(female)
  birthDate   DateTime?
  guardianName String?
  guardianPhone String?
  notes       String?
  joinedAt    DateTime @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         Program?           @relation(fields: [programId], references: [id])
  group           Group?             @relation(fields: [groupId], references: [id])
  memorizationPlan MemorizationPlan?
  lessons         Lesson[]
  attendance      Attendance[]
  evaluations     Evaluation[]
  payments        Payment[]

  @@index([groupId])
  @@index([programId])
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?
  specialty String?
  joinedAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups Group[]
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(uuid())
  name        String
  teacherId   String?
  programId   String?
  meetLink    String?
  maxStudents Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  teacher   Teacher?   @relation(fields: [teacherId], references: [id])
  program   Program?   @relation(fields: [programId], references: [id])
  students  Student[]
  schedules Schedule[]
  lessons   Lesson[]

  @@index([teacherId])
}

// Weekly recurring schedule slot for a group
model Schedule {
  id            String  @id @default(uuid())
  groupId       String
  dayOfWeek     Int     // 0=Sunday .. 6=Saturday
  startTime     String  // "HH:mm"
  durationMins  Int     @default(45)
  timezone      String  @default("Africa/Cairo")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model MemorizationPlan {
  id            String   @id @default(uuid())
  studentId     String   @unique
  currentSurah  String?
  currentAyahFrom Int?
  currentAyahTo   Int?
  reviewSurah   String?
  reviewAyahFrom Int?
  reviewAyahTo   Int?
  progressPct   Int      @default(0)
  notes         String?
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Individual class occurrence
model Lesson {
  id          String       @id @default(uuid())
  groupId     String
  studentId   String?      // null = group-level lesson
  scheduledAt DateTime
  status      LessonStatus @default(scheduled)
  meetLink    String?
  newPortion  String?      // e.g. "آل عمران 1-10"
  reviewPortion String?
  teacherNotes String?
  rescheduledTo DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student?     @relation(fields: [studentId], references: [id])
  attendance  Attendance[]
  evaluation  Evaluation?

  @@index([groupId])
  @@index([studentId])
  @@index([scheduledAt])
}

model Attendance {
  id        String           @id @default(uuid())
  lessonId  String
  studentId String
  status    AttendanceStatus @default(present)
  note      String?

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model Evaluation {
  id          String          @id @default(uuid())
  lessonId    String          @unique
  studentId   String
  memorization EvaluationGrade @default(good)
  review      EvaluationGrade @default(good)
  tajweed     EvaluationGrade @default(good)
  commitment  EvaluationGrade @default(good)
  overallNote String?
  createdAt   DateTime        @default(now())

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Payment {
  id           String        @id @default(uuid())
  studentId    String
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("EGP")
  monthCovered String        // "2026-08"
  method       String        @default("instapay")
  proofUrl     String?
  status       PaymentStatus @default(pending)
  submittedAt  DateTime      @default(now())
  confirmedAt  DateTime?
  confirmedBy  String?       // admin userId
  note         String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}
