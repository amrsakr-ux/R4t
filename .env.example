# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sana_db"
DIRECT_URL="postgresql://postgres:password@localhost:5432/sana_db"

# Auth
AUTH_SECRET="change-me-to-a-strong-random-32-char-string"

# Supabase Storage (for payment proofs, avatars)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="sana-uploads"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="201000000000"
