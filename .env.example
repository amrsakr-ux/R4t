# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/r4t_ops_db"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (for file storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="cv-documents"

# AI Services
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INTERNAL_API_SECRET="your-internal-api-secret-for-ai-endpoints"

# Email (Resend or similar)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@yourplatform.com"

# Scoring weights (0-100, must sum to 100)
SCORING_WEIGHT_CV_QUALITY=20
SCORING_WEIGHT_SKILLS=30
SCORING_WEIGHT_EXPERIENCE=25
SCORING_WEIGHT_ASSESSMENT=25
